// ---------------------------------------------------------------------------
// Novara AI — AI-powered Novel Creation System
// SQLite + Prisma. Structured facts are the single source of truth.
// JSON columns are avoided (SQLite + Prisma); all relations are normalized.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Reserved for the future authentication system (NextAuth-ready).
// The current preview build uses a guest session and does not create users.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Novel — the aggregate root. Everything below cascades from it.
// ---------------------------------------------------------------------------

model Novel {
  id          String   @id @default(cuid())
  title       String
  genre       String   @default("")
  synopsis    String   @default("")
  targetWords Int      @default(100000)
  // drafting | completed | archived
  status      String   @default("drafting")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapters      Chapter[]
  characters    Character[]
  worldEntries  WorldEntry[]
  outlineBeats  OutlineBeat[]
  volumes       Volume[]
  digests       ChapterDigest[]
  storyFacts    StoryFact[]
  characterStates CharacterState[]
  foreshadows   Foreshadow[]
  storylines    Storyline[]
  timelineEntries TimelineEntry[]
  characterArcs CharacterArc[]
  promises      StoryPromise[]
  clues         StoryClue[]
  packs         ChapterPack[]
  contract      NovelContract?
  agentRuns     AgentRun[]

  // 构想快照 (Phase 8) — the initial creative vision snapshot (构想/构想快照.md
  // analog): what the book was imagined to be at creation, kept verbatim so
  // later drift between plan and promise stays auditable.
  conceptSnapshot String @default("")

  @@index([updatedAt])
}

// ---------------------------------------------------------------------------
// Chapter — ordered by `index` (1-based). wordCount is authoritative,
// recomputed server-side on every save (never trusted from the client).
// ---------------------------------------------------------------------------

model Chapter {
  id        String   @id @default(cuid())
  novelId   String
  index     Int
  title     String
  content   String   @default("")
  wordCount Int      @default(0)
  // draft | revised | final
  status    String   @default("draft")
  // Chapter brief (细纲) — the writing brief for this chapter. Persisted so
  // briefs survive the run that created them (webnovel-writer 章细纲 analog).
  // Written by the runtime when a chapter task is delegated/created, and
  // editable by the author via PATCH.
  brief     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  digest ChapterDigest?
  reviews ChapterReview[]
  versions ChapterVersion[]

  @@unique([novelId, index])
  @@index([novelId])
}

// ---------------------------------------------------------------------------
// ChapterVersion (Phase 7) — draft history (webnovel-writer 稿1~稿N analog).
// A row is recorded on EVERY committed content change (author PATCH, agent
// write, approval commit, import). `content` snapshots the INCOMING state,
// so the version list is the full history of committed text states and the
// live Chapter.content column is always the newest working copy. Final
// (定稿) chapters are locked at the API/runtime level — history never
// silently diverges from the canonical text.
// ---------------------------------------------------------------------------

model ChapterVersion {
  id        String   @id @default(cuid())
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  novelId   String
  // 1-based, per-chapter monotonic (稿1, 稿2, …)
  draftNo   Int
  content   String
  wordCount Int
  // author | agent | restore — who committed this state
  createdBy String   @default("author")
  createdAt DateTime @default(now())

  @@unique([chapterId, draftNo])
  @@index([novelId])
}

// ---------------------------------------------------------------------------
// ChapterReview (Phase 6) — persisted review verdicts, written ONLY by the
// review core (lib/novara/review.ts). The E2 gate reads the LATEST row per
// chapter to decide whether the chapter may be finalized (blocking = 0) —
// the gate is code-enforced, never model-claimed. issuesJson holds the full
// issue list (SQLite + Prisma: no JSON columns).
// ---------------------------------------------------------------------------

model ChapterReview {
  id            String   @id @default(cuid())
  novelId       String
  chapterId     String
  chapter       Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  issueCount    Int
  blockingCount Int
  issuesJson    String
  // tab (author Review tab) | agent (Prism in the tool loop)
  source        String   @default("tab")
  createdAt     DateTime @default(now())

  @@index([chapterId, createdAt])
  @@index([novelId])
}

// ---------------------------------------------------------------------------
// Character — story bible cast entry.
// ---------------------------------------------------------------------------

model Character {
  id          String   @id @default(cuid())
  novelId     String
  name        String
  role        String   @default("")
  description String   @default("")
  // Phase 7 (P1) — comma-separated alternate names (DSH 人物设定 analog).
  // Sediment normalizes STATE names through this map so aliases (林晚/晚姐)
  // no longer split CharacterState snapshots across name keys.
  aliases     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
}

// ---------------------------------------------------------------------------
// WorldEntry — worldbuilding bible: places, factions, systems, items, lore.
// ---------------------------------------------------------------------------

model WorldEntry {
  id        String   @id @default(cuid())
  novelId   String
  title     String
  // location | faction | item | system | culture | other
  category  String   @default("other")
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
}

// ---------------------------------------------------------------------------
// OutlineBeat — plot outline beats in narrative order. Optional volume
// grouping (DSH 大纲/卷规划 analog): beats with the same volumeId render
// under that volume in the outline panel and asset tree; unassigned beats
// render in the top "Unsorted" section so nothing is ever hidden.
// ---------------------------------------------------------------------------

model OutlineBeat {
  id        String   @id @default(cuid())
  novelId   String
  index     Int
  title     String
  summary   String   @default("")
  volumeId  String?
  volume    Volume?  @relation(fields: [volumeId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([novelId, index])
  @@index([novelId])
  @@index([volumeId])
}

// ---------------------------------------------------------------------------
// Volume (Phase 7 P1) — story arc partition (DSH 大纲/卷规划.md analog).
// Holds the volume-level plan (卷规划): what this arc promises, where it
// starts/ends. Ordered by `index` (1-based) per novel.
// ---------------------------------------------------------------------------

model Volume {
  id        String   @id @default(cuid())
  novelId   String
  index     Int
  title     String
  // Volume plan (卷规划) — markdown: promise of this arc, entry/exit state.
  synopsis  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  novel Novel      @relation(fields: [novelId], references: [id], onDelete: Cascade)
  beats OutlineBeat[]

  @@unique([novelId, index])
  @@index([novelId])
}

// ---------------------------------------------------------------------------
// Ledger (Phase 7 P1) — DSH 账本 analogs. Three author-and-agent-maintained
// ledgers that live beside the memory sediment (NOT merged into it: they are
// plan-level truth the author curates, while sediment is chapter-derived):
//   Storyline      — named plot threads and their status (故事线.md)
//   TimelineEntry  — ordered in-story events (时间线.md)
//   CharacterArc   — per-character arc stages (人物弧线.md)
// ---------------------------------------------------------------------------

model Storyline {
  id        String   @id @default(cuid())
  novelId   String
  name      String
  summary   String   @default("")
  // active | dormant | resolved
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, status])
}

model TimelineEntry {
  id           String   @id @default(cuid())
  novelId      String
  // Display order (1-based) — narrative order, not chronological order.
  order        Int
  label        String
  detail       String   @default("")
  chapterIndex Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([novelId, order])
  @@index([novelId])
}

model CharacterArc {
  id            String   @id @default(cuid())
  novelId       String
  characterName String
  // Stage order within the character's arc (1-based): 起点 → 转变 → 终点.
  order         Int
  note          String
  chapterIndex  Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, characterName])
}

// ---------------------------------------------------------------------------
// NovelContract (Phase 7 P1) — DSH 作品契约.md analog: the promise document
// (genre promise, audience, style commitments, taboos). 1:1 with the novel.
// Written by the author (Details dialog) and read into writing context.
// ---------------------------------------------------------------------------

model NovelContract {
  novelId   String   @id
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Ledger (Phase 8) — the two remaining 账本 analogs, completing the five-file
// ledger: Storyline/TimelineEntry/CharacterArc (Phase 7 P1) + these two.
//   StoryPromise   — promises made to the reader (承诺.md)
//   StoryClue      — clue/evidence threads and their reveal state (线索.md)
// Both are plan-level truth curated by author and agent; the Foreshadow
// sediment table stays chapter-derived and separate.
// ---------------------------------------------------------------------------

model StoryPromise {
  id          String   @id @default(cuid())
  novelId     String
  content     String
  // open | fulfilled | broken
  status      String   @default("open")
  // Chapter where the promise was made / where it is due.
  madeChapter Int?
  dueChapter  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, status])
}

model StoryClue {
  id            String   @id @default(cuid())
  novelId       String
  content       String
  // planted | surfaced | revealed
  status        String   @default("planted")
  plantChapter  Int?
  revealChapter Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, status])
}

// ---------------------------------------------------------------------------
// ChapterPack (Phase 8) — 草稿区 workspace documents, one per chapter per kind:
//   material (材料包)  — pre-draft background/evidence the writer assembles
//   prep     (定稿准备) — pre-finalize atomic pack (review verdicts, fixes)
// Keyed by chapterIndex (not chapterId) so a pack can exist BEFORE the
// chapter itself — the 草稿区 packs chapters not yet drafted.
// ---------------------------------------------------------------------------

model ChapterPack {
  id           String   @id @default(cuid())
  novelId      String
  // material | prep
  kind         String   @default("material")
  chapterIndex Int
  title        String
  content      String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([novelId, kind, chapterIndex])
  @@index([novelId])
}

// ---------------------------------------------------------------------------
// Sediment layer (Phase 2) — written ONLY by the sediment pipeline
// (POST /api/chapters/[id]/sediment) after a blocking-free review.
// Single source of truth: each fact type has exactly one writable home.
// StoryFact mirrors the designed MemoryItem contract (agent-types.ts):
// category mirrors MemoryCategory; sourceChapter/firstSeen/lastSeen same
// semantics — Phase 4 builds FTS/recall on top of this table, not beside it.
// ---------------------------------------------------------------------------

model ChapterDigest {
  id        String   @id @default(cuid())
  chapterId String   @unique
  novelId   String
  summary   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  novel   Novel   @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
}

model StoryFact {
  id            String   @id @default(cuid())
  novelId       String
  // world_rule | character_state | relationship | story_fact | open_loop
  // | decision | style | dialogue | inspiration   (Phase 7: 5 -> 9)
  category      String
  content       String
  sourceChapter Int?
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @updatedAt
  // Chapter that last resurfaced this fact (sediment touch). Drives honest
  // recency in the Phase 4 retrieval scoring — a fact re-used in ch. 12 is
  // "hot" even if first planted in ch. 1.
  lastSeenChapter Int?

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, category])
}

model CharacterState {
  id           String   @id @default(cuid())
  novelId      String
  name         String
  chapterIndex Int
  state        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([novelId, name, chapterIndex])
  @@index([novelId, name])
}

model Foreshadow {
  id           String   @id @default(cuid())
  novelId      String
  content      String
  plantChapter Int
  payByChapter Int?
  // open -> advanced -> paid (settlement happens only in a sediment step)
  status       String   @default("open")
  lastChapter  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, status])
}

// ---------------------------------------------------------------------------
// Agent runtime (Phase 3) — the Agent Task Board's source of truth (§4.1).
// A run decomposes a goal into tasks, streams events, and pauses at gates.
// Honesty rule: task `done` flips are written by the runtime AFTER a verified
// DB write — never by model self-report. finalReport/payload hold JSON strings
// (SQLite + Prisma: no JSON columns), serialized into the frozen DTO shapes
// in lib/novara/agent-types.ts.
// ---------------------------------------------------------------------------

model AgentRun {
  id       String   @id @default(cuid())
  novelId  String
  novel    Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  goal     String
  // approval | full_access
  mode     String   @default("approval")
  // running | awaiting_approval | paused | completed | failed | cancelled
  status   String   @default("running")
  // RunFinalReport JSON (reported vs verified numbers) — null until finished
  finalReport String?
  // PinnedRef[] JSON — author-pinned context refs resolved at execution time
  pinnedJson String?
  error    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks  AgentTask[]
  events AgentEvent[]

  @@index([novelId, status])
  @@index([updatedAt])
}

model AgentTask {
  id     String   @id @default(cuid())
  runId  String
  run    AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  // Display key: "Task 1", "Task 3-a" (letter = parallel group member)
  key    String
  parallelGroup String?
  // Member role executing this task (Phase 5 delegate) — atlas|sage|nova|prism|forge
  assignee String @default("sage")
  title  String
  detail String   @default("")
  // pending | in_progress | needs_approval | blocked | failed | done
  status String   @default("pending")
  // chapter | character | world_entry | outline_beat — binds to asset tree
  artifactType  String?
  artifactId    String?
  artifactLabel String?
  order  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills SkillInvocation[]

  @@index([runId, order])
}

model AgentEvent {
  id     String   @id @default(cuid())
  runId  String
  run    AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  taskId String?
  // Member that produced the event — atlas|sage|nova|prism|forge|author
  actor  String   @default("atlas")
  // task_update | tool_call | write | message | error | approval
  kind   String
  summary String
  // JSON payload string (write events carry the pending draft for the gate)
  payload String?
  createdAt DateTime @default(now())

  @@index([runId, createdAt])
}

// Phase 5 telemetry — which skills were injected into which member task.
model SkillInvocation {
  id     String    @id @default(cuid())
  taskId String
  task   AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  skillId String
  // true = actually concatenated into the member system prompt
  injected Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([taskId])
}
