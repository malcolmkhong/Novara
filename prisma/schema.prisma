// ---------------------------------------------------------------------------
// Novara AI — AI-powered Novel Creation System
// SQLite + Prisma. Structured facts are the single source of truth.
// JSON columns are avoided (SQLite + Prisma); all relations are normalized.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Reserved for the future authentication system (NextAuth-ready).
// The current preview build uses a guest session and does not create users.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Novel — the aggregate root. Everything below cascades from it.
// ---------------------------------------------------------------------------

model Novel {
  id          String   @id @default(cuid())
  title       String
  genre       String   @default("")
  synopsis    String   @default("")
  targetWords Int      @default(100000)
  // drafting | completed | archived
  status      String   @default("drafting")
  userId     String?
  @@index([userId])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapters      Chapter[]
  characters    Character[]
  worldEntries  WorldEntry[]
  worldGroups   WorldGroup[]
  outlineBeats  OutlineBeat[]
  volumes       Volume[]
  digests       ChapterDigest[]
  storyFacts    StoryFact[]
  characterStates CharacterState[]
  foreshadows   Foreshadow[]
  storylines    Storyline[]
  timelineEntries TimelineEntry[]
  characterArcs CharacterArc[]
  promises      StoryPromise[]
  clues         StoryClue[]
  packs         ChapterPack[]
  assetVersions AssetVersion[]
  contract      NovelContract?
  agentRuns     AgentRun[]

  // 构想快照 (Phase 8) — the initial creative vision snapshot (构想/构想快照.md
  // analog): what the book was imagined to be at creation, kept verbatim so
  // later drift between plan and promise stays auditable.
  conceptSnapshot String @default("")

  @@index([updatedAt])
}

// ---------------------------------------------------------------------------
// Chapter — ordered by `index` (1-based). wordCount is authoritative,
// recomputed server-side on every save (never trusted from the client).
// ---------------------------------------------------------------------------

model Chapter {
  id        String   @id @default(cuid())
  novelId   String
  index     Int
  title     String
  content   String   @default("")
  wordCount Int      @default(0)
  // draft | revised | final
  status    String   @default("draft")
  // Chapter brief (细纲) — the writing brief for this chapter. Persisted so
  // briefs survive the run that created them (webnovel-writer 章细纲 analog).
  // Written by the runtime when a chapter task is delegated/created, and
  // editable by the author via PATCH.
  brief     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  digest ChapterDigest?
  reviews ChapterReview[]
  versions ChapterVersion[]

  @@unique([novelId, index])
  @@index([novelId])
}

// ---------------------------------------------------------------------------
// ChapterVersion (Phase 7) — draft history (webnovel-writer 稿1~稿N analog).
// A row is recorded on EVERY committed content change (author PATCH, agent
// write, approval commit, import). `content` snapshots the INCOMING state,
// so the version list is the full history of committed text states and the
// live Chapter.content column is always the newest working copy. Final
// (定稿) chapters are locked at the API/runtime level — history never
// silently diverges from the canonical text.
// ---------------------------------------------------------------------------

model ChapterVersion {
  id        String   @id @default(cuid())
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  novelId   String
  // 1-based, per-chapter monotonic (稿1, 稿2, …)
  draftNo   Int
  content   String
  wordCount Int
  // author | agent | restore — who committed this state
  createdBy String   @default("author")
  createdAt DateTime @default(now())

  @@unique([chapterId, draftNo])
  @@index([novelId])
}

// ---------------------------------------------------------------------------
// ChapterReview (Phase 6) — persisted review verdicts, written ONLY by the
// review core (lib/novara/review.ts). The E2 gate reads the LATEST row per
// chapter to decide whether the chapter may be finalized (blocking = 0) —
// the gate is code-enforced, never model-claimed. issuesJson holds the full
// issue list (SQLite + Prisma: no JSON columns).
// ---------------------------------------------------------------------------

model ChapterReview {
  id            String   @id @default(cuid())
  novelId       String
  chapterId     String
  chapter       Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  issueCount    Int
  blockingCount Int
  issuesJson    String
  // tab (author Review tab) | agent (Prism in the tool loop)
  source        String   @default("tab")
  createdAt     DateTime @default(now())

  @@index([chapterId, createdAt])
  @@index([novelId])
}

// ---------------------------------------------------------------------------
// Character — story bible cast entry.
// ---------------------------------------------------------------------------

model Character {
  id          String   @id @default(cuid())
  novelId     String
  name        String
  role        String   @default("")
  description String   @default("")
  // Phase 7 (P1) — comma-separated alternate names (DSH 人物设定 analog).
  // Sediment normalizes STATE names through this map so aliases (林晚/晚姐)
  // no longer split CharacterState snapshots across name keys.
  aliases     String   @default("")
  // Canon status layer (Phase 9) — non-body assets obey the same write-gate
  // law as chapters: draft = editable workspace, final = locked canon. Any
  // mutation of a final asset requires explicit `reopen: true` which archives
  // the final state into AssetVersion and downgrades status to draft.
  status      String   @default("draft")
  finalizedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
}

// ---------------------------------------------------------------------------
// WorldEntry — worldbuilding bible: places, factions, systems, items, lore.
// ---------------------------------------------------------------------------

model WorldEntry {
  id        String   @id @default(cuid())
  novelId   String
  title     String
  // location | faction | item | system | culture | other
  category  String   @default("other")
  content   String   @default("")
  // Canon status layer (Phase 9) — same write-gate law as Character.
  status      String    @default("draft")
  finalizedAt DateTime?
  // Second-level grouping (Phase 9) — 世界书/世界规则 two-level tree. NULL
  // entries render in the top "Ungrouped" section so nothing is ever hidden.
  groupId   String?
  group     WorldGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
  @@index([groupId])
}

// ---------------------------------------------------------------------------
// WorldGroup (Phase 9) — second-level grouping inside the world bible
// (DSH 世界书/世界规则 analog). Ordered per novel; entries nest under their
// group in the asset tree and Memory tab. Ungrouped entries stay visible.
// ---------------------------------------------------------------------------

model WorldGroup {
  id        String   @id @default(cuid())
  novelId   String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  novel   Novel        @relation(fields: [novelId], references: [id], onDelete: Cascade)
  entries WorldEntry[]

  @@unique([novelId, name])
  @@index([novelId])
}

// ---------------------------------------------------------------------------
// OutlineBeat — plot outline beats in narrative order. Optional volume
// grouping (DSH 大纲/卷规划 analog): beats with the same volumeId render
// under that volume in the outline panel and asset tree; unassigned beats
// render in the top "Unsorted" section so nothing is ever hidden.
// ---------------------------------------------------------------------------

model OutlineBeat {
  id        String   @id @default(cuid())
  novelId   String
  index     Int
  title     String
  summary   String   @default("")
  volumeId  String?
  volume    Volume?  @relation(fields: [volumeId], references: [id], onDelete: SetNull)
  // Canon status layer (Phase 9) — same write-gate law as Character.
  status      String    @default("draft")
  finalizedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([novelId, index])
  @@index([novelId])
  @@index([volumeId])
}

// ---------------------------------------------------------------------------
// Volume (Phase 7 P1) — story arc partition (DSH 大纲/卷规划.md analog).
// Holds the volume-level plan (卷规划): what this arc promises, where it
// starts/ends. Ordered by `index` (1-based) per novel.
// ---------------------------------------------------------------------------

model Volume {
  id        String   @id @default(cuid())
  novelId   String
  index     Int
  title     String
  // Volume plan (卷规划) — markdown: promise of this arc, entry/exit state.
  synopsis  String   @default("")
  // Canon status layer (Phase 9) — same write-gate law as Character.
  status      String    @default("draft")
  finalizedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  novel Novel      @relation(fields: [novelId], references: [id], onDelete: Cascade)
  beats OutlineBeat[]

  @@unique([novelId, index])
  @@index([novelId])
}

// ---------------------------------------------------------------------------
// Ledger (Phase 7 P1) — DSH 账本 analogs. Three author-and-agent-maintained
// ledgers that live beside the memory sediment (NOT merged into it: they are
// plan-level truth the author curates, while sediment is chapter-derived):
//   Storyline      — named plot threads and their status (故事线.md)
//   TimelineEntry  — ordered in-story events (时间线.md)
//   CharacterArc   — per-character arc stages (人物弧线.md)
// ---------------------------------------------------------------------------

model Storyline {
  id        String   @id @default(cuid())
  novelId   String
  name      String
  summary   String   @default("")
  // active | dormant | resolved (thread lifecycle)
  status    String   @default("active")
  // Canon status layer (Phase 9): draft | final — locks edits via write-gate.
  // (named differently from thread lifecycle on purpose: lock, not status.)
  lock      String   @default("draft")
  finalizedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, status])
}

model TimelineEntry {
  id           String   @id @default(cuid())
  novelId      String
  // Display order (1-based) — narrative order, not chronological order.
  order        Int
  label        String
  detail       String   @default("")
  chapterIndex Int?
  // Canon status layer (Phase 9) — same write-gate law as Character.
  status       String   @default("draft")
  finalizedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([novelId, order])
  @@index([novelId])
}

model CharacterArc {
  id            String   @id @default(cuid())
  novelId       String
  characterName String
  // Stage order within the character's arc (1-based): 起点 → 转变 → 终点.
  order         Int
  note          String
  chapterIndex  Int?
  // Canon status layer (Phase 9) — same write-gate law as Character.
  status        String   @default("draft")
  finalizedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, characterName])
}

// ---------------------------------------------------------------------------
// NovelContract (Phase 7 P1) — DSH 作品契约.md analog: the promise document
// (genre promise, audience, style commitments, taboos). 1:1 with the novel.
// Written by the author (Details dialog) and read into writing context.
// ---------------------------------------------------------------------------

model NovelContract {
  novelId     String    @id
  content     String    @default("")
  // Canon status layer (Phase 9) — a finalized contract is locked canon;
  // editing requires reopen (write-gate), archive goes to AssetVersion.
  status      String    @default("draft")
  finalizedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Ledger (Phase 8) — the two remaining 账本 analogs, completing the five-file
// ledger: Storyline/TimelineEntry/CharacterArc (Phase 7 P1) + these two.
//   StoryPromise   — promises made to the reader (承诺.md)
//   StoryClue      — clue/evidence threads and their reveal state (线索.md)
// Both are plan-level truth curated by author and agent; the Foreshadow
// sediment table stays chapter-derived and separate.
// ---------------------------------------------------------------------------

model StoryPromise {
  id          String   @id @default(cuid())
  novelId     String
  content     String
  // open | fulfilled | broken
  status      String   @default("open")
  // Canon status layer (Phase 9): draft | final — lock, not lifecycle.
  lock        String   @default("draft")
  finalizedAt DateTime?
  // Chapter where the promise was made / where it is due.
  madeChapter Int?
  dueChapter  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, status])
}

model StoryClue {
  id            String   @id @default(cuid())
  novelId       String
  content       String
  // planted | surfaced | revealed
  status        String   @default("planted")
  // Canon status layer (Phase 9): draft | final — lock, not lifecycle.
  lock          String   @default("draft")
  finalizedAt   DateTime?
  plantChapter  Int?
  revealChapter Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, status])
}

// ---------------------------------------------------------------------------
// ChapterPack (Phase 8) — 草稿区 workspace documents, one per chapter per kind:
//   material (材料包)  — pre-draft background/evidence the writer assembles
//   prep     (定稿准备) — pre-finalize atomic pack (review verdicts, fixes)
// Keyed by chapterIndex (not chapterId) so a pack can exist BEFORE the
// chapter itself — the 草稿区 packs chapters not yet drafted.
// ---------------------------------------------------------------------------

model ChapterPack {
  id           String   @id @default(cuid())
  novelId      String
  // material | prep
  kind         String   @default("material")
  chapterIndex Int
  title        String
  content      String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([novelId, kind, chapterIndex])
  @@index([novelId])
}

// ---------------------------------------------------------------------------
// Sediment layer (Phase 2) — written ONLY by the sediment pipeline
// (POST /api/chapters/[id]/sediment) after a blocking-free review.
// Single source of truth: each fact type has exactly one writable home.
// StoryFact mirrors the designed MemoryItem contract (agent-types.ts):
// category mirrors MemoryCategory; sourceChapter/firstSeen/lastSeen same
// semantics — Phase 4 builds FTS/recall on top of this table, not beside it.
// ---------------------------------------------------------------------------

model ChapterDigest {
  id        String   @id @default(cuid())
  chapterId String   @unique
  novelId   String
  summary   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  novel   Novel   @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
}

model StoryFact {
  id            String   @id @default(cuid())
  novelId       String
  // world_rule | character_state | relationship | story_fact | open_loop
  // | decision | style | dialogue | inspiration   (Phase 7: 5 -> 9)
  category      String
  content       String
  sourceChapter Int?
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @updatedAt
  // Chapter that last resurfaced this fact (sediment touch). Drives honest
  // recency in the Phase 4 retrieval scoring — a fact re-used in ch. 12 is
  // "hot" even if first planted in ch. 1.
  lastSeenChapter Int?

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, category])
}

model CharacterState {
  id           String   @id @default(cuid())
  novelId      String
  name         String
  chapterIndex Int
  state        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([novelId, name, chapterIndex])
  @@index([novelId, name])
}

model Foreshadow {
  id           String   @id @default(cuid())
  novelId      String
  content      String
  plantChapter Int
  payByChapter Int?
  // open -> advanced -> paid (settlement happens only in a sediment step)
  status       String   @default("open")
  lastChapter  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, status])
}

// ---------------------------------------------------------------------------
// Agent runtime (Phase 3) — the Agent Task Board's source of truth (§4.1).
// A run decomposes a goal into tasks, streams events, and pauses at gates.
// Honesty rule: task `done` flips are written by the runtime AFTER a verified
// DB write — never by model self-report. finalReport/payload hold JSON strings
// (SQLite + Prisma: no JSON columns), serialized into the frozen DTO shapes
// in lib/novara/agent-types.ts.
// ---------------------------------------------------------------------------

model AgentRun {
  id       String   @id @default(cuid())
  novelId  String
  novel    Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  goal     String
  // approval | full_access
  mode     String   @default("approval")
  // running | awaiting_approval | paused | completed | failed | cancelled
  status   String   @default("running")
  // P2 — model registry id + thinking level this run executes with
  // (validated against src/lib/novara/models.ts at creation AND execution)
  modelId        String @default("gemini:fast")
  thinkingLevel  String @default("low")
  // RunFinalReport JSON (reported vs verified numbers) — null until finished
  finalReport String?
  // PinnedRef[] JSON — author-pinned context refs resolved at execution time
  pinnedJson String?
  error    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 1 resume — leader-loop cursor + scalar state (turnsUsed,
  // taskCounter, delegateCount, claimed, issues, qcRepairs, impactReport,
  // wrapUpGranted). Serialized by lib/agent/messages.ts; null = fresh run /
  // nothing checkpointed yet. Written via lease-fenced CAS only, AFTER the
  // matching transcript appends (append-then-bump ordering).
  stateJson String?
  // Executor lease (lib/agent/messages.ts): CAS-claimed, heartbeat-renewed,
  // epoch-fenced so a stale executor can never advance run state or append
  // to a conversation it no longer owns.
  leaseOwner      String?
  leaseHeartbeatAt DateTime?
  leaseEpoch      Int      @default(0)

  // Phase 2 — governs ONLY system-prompt delivery on the wire:
  // "v1" = system card replayed as the fake assistant message (system_note
  // row — today's wire, byte-identical guarantee); "v2" = native system
  // message (Phase 3's first step flips it; Phase 2 never writes anything
  // but this default). Compaction eligibility does NOT key off this —
  // budgets.contextCompaction owns that (agent-ctx/p2-design.md §1).
  contextSpec String @default("v1")

  tasks  AgentTask[]
  events AgentEvent[]
  messages AgentMessage[]
  summaries ContextSummary[]

  @@index([novelId, status])
  @@index([updatedAt])
}

model AgentTask {
  id     String   @id @default(cuid())
  runId  String
  run    AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  // Display key: "Task 1", "Task 3-a" (letter = parallel group member)
  key    String
  parallelGroup String?
  // Member role executing this task (Phase 5 delegate) — atlas|sage|nova|prism|forge
  assignee String @default("sage")
  title  String
  detail String   @default("")
  // pending | in_progress | needs_approval | blocked | failed | done
  status String   @default("pending")
  // chapter | character | world_entry | outline_beat — binds to asset tree
  artifactType  String?
  artifactId    String?
  artifactLabel String?
  order  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills SkillInvocation[]

  @@index([runId, order])
}

model AgentEvent {
  id     String   @id @default(cuid())
  runId  String
  run    AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  taskId String?
  // Member that produced the event — atlas|sage|nova|prism|forge|author
  actor  String   @default("atlas")
  // task_update | tool_call | write | message | error | approval
  kind   String
  summary String
  // JSON payload string (write events carry the pending draft for the gate)
  payload String?
  createdAt DateTime @default(now())

  @@index([runId, createdAt])
}

// ---------------------------------------------------------------------------
// AgentMessage (Phase 1) — CANONICAL conversation transcript, one row per
// chat message, FULL verbatim content (AgentEvent stays the truncated UI
// event stream and is never replayed into a model context). One conversation
// per leader (conversationId="leader") and one per member task
// (conversationId=taskId), isolated by the (runId, conversationId, seq)
// unique index. seq is allocated inside the same transaction as the insert
// (SQLite single-writer serialization) and the unique index is the hard
// backstop — duplicates are impossible to commit, not merely unlikely.
// Restore order is seq ASC only; createdAt is never used for ordering.
// ---------------------------------------------------------------------------

model AgentMessage {
  id             String   @id @default(cuid())
  runId          String
  run            AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  // Owning member task; null on leader conversation rows.
  taskId         String?
  // Conversation key within the run: "leader" | taskId.
  conversationId String
  // Conversation owner: atlas | sage | nova | prism | forge
  agent          String
  // LLM chat role of this message: "user" | "assistant"
  role           String
  // 1-based monotonic per conversation.
  seq            Int
  // FULL verbatim content — never truncated (canonical transcript).
  content        String
  // system_note | envelope | reply | tool_results | repair | gate_stop | wrap_up | resume_note
  // (gate_stop / resume_note are audit markers, never replayed into a model context)
  kind           String
  createdAt      DateTime @default(now())

  @@unique([runId, conversationId, seq])
  @@index([runId, conversationId, seq])
  @@index([taskId])
}

// ---------------------------------------------------------------------------
// ContextSummary (Phase 2) — compaction projection over the canonical
// transcript. DERIVED state: AgentMessage stays the ONLY source of truth —
// transcript rows are never deleted or mutated; summaries merely COVER
// [fromSeq..toSeq] so any projection is re-derivable and auditable
// (agent-ctx/p2-design.md §2).
//
// Absorb-chain: each row is a DETERMINISTIC, ZERO-GLM projection RECOMPUTED
// from the raw canonical AgentMessage rows over [fromSeq..toSeq] ONLY (design
// §2.0 — prior summary text is NEVER an input; the superseded row exists to
// define the prior cut and as the audit trail of cuts). One row reaches back
// to the FIRST compacted seq (envelope.seq + 1); replay = newest active row
// only + verbatim tail, keeping the active-context cap flat no matter how
// many compactions fire. Exactly one active row per (runId, conversationId)
// (supersededAt IS NULL) — the prior row is fenced-superseded when the new
// one lands.
//
// Fencing: written ONLY by the leaseholder inside a lease-verified
// transaction; leaseEpoch is the fencing token — a deposed compacter's write
// lands count=0 and the winner recomputes from canonical AgentMessage.
// Idempotent per cut point via @@unique([runId, conversationId, toSeq])
// (crash→retry at the same cut hits P2002 and treats the existing row as
// done). Eligibility is governed ONLY by budgets.contextCompaction (enabled
// + triggerTokens) — NEVER by contextSpec, which decides system-note wire
// delivery exclusively.
// ---------------------------------------------------------------------------

model ContextSummary {
  id             String    @id @default(cuid())
  runId          String
  run            AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  // Conversation key within the run: "leader" | taskId (same keys as AgentMessage).
  conversationId String
  // Member conversations carry the task id; null on leader rows (symmetric
  // with AgentMessage).
  taskId         String?
  // Conversation owner: atlas | sage | nova | prism | forge
  agent          String
  // Contiguous cover [fromSeq..toSeq] over AgentMessage.seq, marker kinds
  // included (the seq domain has no holes). fromSeq === envelope.seq + 1 for
  // the chain head; toSeq is the cut point.
  fromSeq        Int
  toSeq          Int
  // Deterministic projection text (raw rows over [fromSeq..toSeq] ONLY —
  // design §2.0; prior summary text is never an input).
  summary        String
  // Lease fencing token at write time (AgentRun.leaseEpoch when written).
  leaseEpoch     Int       @default(0)
  // null = active chain head; non-null = superseded by a newer absorb row.
  supersededAt   DateTime?
  createdAt      DateTime  @default(now())

  @@unique([runId, conversationId, toSeq])
  @@index([runId, conversationId, supersededAt])
}

// Phase 5 telemetry — which skills were injected into which member task.
model SkillInvocation {
  id     String    @id @default(cuid())
  taskId String
  task   AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  skillId String
  // true = actually concatenated into the member system prompt
  injected Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([taskId])
}

// ---------------------------------------------------------------------------
// AssetVersion (Phase 9) — the immutable history layer for NON-BODY assets
// (characters, world entries, outline beats, volumes, ledger rows, contract).
// Chapters already snapshot via ChapterVersion; everything else snapshots
// here. Rows are written:
//   1. when a FINAL asset is reopened (the final state is archived verbatim
//      before the downgrade — 保留原版);
//   2. when a finalized asset is locked (the canon state is archived);
//   3. on explicit manual snapshots from the canon UI.
// `snapshot` holds the full pre-change field values as a labeled text block
// (SQLite + Prisma: no JSON columns). 修订走流程并留记录 = status field +
// these rows; nothing else may mutate canon history.
// ---------------------------------------------------------------------------

model AssetVersion {
  id        String   @id @default(cuid())
  novelId   String
  // character | world_entry | outline_beat | volume | storyline |
  // timeline_entry | character_arc | story_promise | story_clue | contract
  assetType String
  assetId   String
  assetLabel String  @default("")
  // reopen | finalize | manual — why this snapshot exists
  reason    String   @default("manual")
  snapshot  String
  createdBy String   @default("author")
  createdAt DateTime @default(now())

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, assetType, assetId])
  @@index([assetId, createdAt])
}

// ---------------------------------------------------------------------------
// UsageCall (Phase 5 / P5-a) — the PERSISTED, account-level GLM usage ledger.
// ONE row per MEASURED provider call, every surface (agent | draft | review |
// sediment | studio | wizard | detect | generate | ai-team). Single source of
// truth for usage (Ruling 2, user 2026-11-05); the in-memory per-process
// ledger it supersedes is retired in P5-b.
//
// RETENTION (Ruling R-2, user 2026-11-06 — supersedes Ruling 1's
// "permanent, no purge"): detail rows are retained 90 DAYS after their call,
// then PERMANENTLY DELETED — but only AFTER their tokens/counts are rolled
// up into UsageDaily (day × surface × novel-or-null × model), which is
// NEVER deleted. The purge must remain an explicit, deterministic,
// idempotent sweep keyed on createdAt alone — NEVER a side effect of content
// deletion (novelId / runId are PLAIN STRINGS — NO foreign key, NO cascade:
// deleting a novel or a run must never erase account-scope spend history;
// orphans render as "(deleted novel)" in the account view). Users can
// export a CSV statement of the retained window before expiry.
//
// HONESTY RULE: measured calls only — a null/stripped usage object records
// NOTHING (never guessed, never padded). Estimates live in the agent usage
// events (panel payloads), never here. modelId records the REQUEST-side
// value exactly as sent (the docs' pricing key); "gateway-default" means the
// request carried no model field (response echoes are rewritten by the
// gateway — phase3-stages.md §P3-A-2).
// ---------------------------------------------------------------------------

model UsageCall {
  id               String   @id @default(cuid())
  surface          String
  modelId          String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  // P5-b failed-call accounting (Policy F): "measured" = the provider
  // returned a usage object and the tokens above ARE its billed truth.
  // "failed" = the attempt ended with NO completion payload at our boundary
  // (timeout / transport drop / 429 / 5xx / mid-flight abort); the zero token
  // values mean UNKNOWN, not zero-billed — provider-side billing of such
  // attempts is unobservable at our boundary (no billing API). One row per
  // HTTP attempt: retries are separate rows.
  status           String   @default("measured")
  // Why an attempt failed (timeout | rate-limit | server-error | network |
  // aborted | unknown). Null on measured rows.
  errorKind        String?
  // Scope links — nullable, plain strings, NO FK (see retention above).
  runId            String?
  taskId           String?
  // Agent conversation key: "leader" | taskId. Null elsewhere.
  conversationId   String?
  novelId          String?
  // Request/session correlation id for retro-tagging (studio-init request id,
  // wizard client session id); resolves via UsageProvenance at novel creation.
  correlationId    String?
  // ATTRIBUTION (Step 53): the caller who paid for this call. Nullable on
  // purpose — a row written outside a request scope (background job, script)
  // has no owner to name, and inventing one would be a lie. Null rows are
  // reported, never guessed. Stamped by the ownership extension on create
  // (src/lib/db.ts stamps `userId` for every model that carries the column).
  userId           String?
  createdAt        DateTime @default(now())

  @@index([surface, createdAt])
  @@index([novelId, createdAt])
  @@index([runId])
  @@index([correlationId])
  @@index([createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// UsageProvenance (Phase 5 / P5-a) — the retro-tag link (user ruling
// 2026-11-05): a pre-novel surface's consumption is attached to the novel it
// culminated in, AT THE MOMENT OF CREATION. One row per (correlationId,
// novelId) — the unique index makes link creation idempotent (a retried
// create cannot double-link). Sessions that never produce a novel simply
// never appear here — their calls stay in the global account ledger only.
// Same retention rule as UsageCall: novelId is a plain string, no cascade.
// ---------------------------------------------------------------------------

model UsageProvenance {
  id            String   @id @default(cuid())
  correlationId String
  // studio-init (server-generated request id) | wizard (client session id)
  surface       String
  novelId       String
  createdAt     DateTime @default(now())

  @@unique([correlationId, novelId])
  @@index([novelId])
}

// ---------------------------------------------------------------------------
// UsageDaily (Phase 5 / P5-f, Ruling R-2) — the permanent daily aggregate.
// One row per (UTC day × surface × novel-or-null × model). Consumed by the
// purge: every UsageCall row older than the 90-day retention window is
// rolled up here BEFORE its detail row is deleted; aggregates are NEVER
// deleted by any code path. Views render recent history from UsageCall
// detail rows (~31 days) and everything older from these summaries, labeled
// "summary — details retained 90 days"; account/novel lifetime totals are
// aggregates + retained details, so totals are invariant across a purge
// (tokens and counts are preserved exactly; the estimate is an upper bound
// computed from preserved tokens at render time).
//
// novelKey is the uniqueness-safe form of the novel-or-null dimension (the
// novelId, or "-" for account-wide rows): SQLite unique indexes treat NULLs
// as distinct, so a nullable column alone cannot carry an idempotent upsert.
// novelId stays alongside for readability and filtering; it is a plain
// string — NO foreign key, NO cascade, same family as UsageCall.
//
// estimatedUsd is the bucket's Σ upper-bound ESTIMATE over its PRICED
// contributions at rollup time (null = nothing in this bucket was priced —
// never $0-by-guess). pricingVersion records which sourced price table
// produced the latest contribution. If the 90-day window later crosses a
// pricing-version change, the ESTIMATE column is a blend across versions —
// the authoritative account estimate is recomputed from preserved tokens at
// render time; this column is the statement's per-bucket figure, labeled.
// ---------------------------------------------------------------------------

model UsageDaily {
  id               String   @id @default(cuid())
  // UTC day of the rolled-up detail rows, "YYYY-MM-DD" (from createdAt).
  day              String
  surface          String
  modelId          String
  novelId          String?
  // novelId, or "-" for account-wide (unlinked) rows — the upsert key.
  novelKey         String
  calls            Int
  failedCalls      Int
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  estimatedUsd     Float?
  pricingVersion   String
  // ATTRIBUTION (Step 53): the owner of the rolled-up bucket — the same
  // caller as the UsageCall detail rows it was summed from. Nullable: a
  // bucket whose rows had no attributable owner stays unattributed.
  userId           String?
  rolledAt         DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([day, surface, novelKey, modelId])
  @@index([day])
  @@index([novelKey, day])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// UsageInvoice (Phase 5 / P5-c, proposal §6.3) — the invoice reconciliation
// entry. One row per paste of the account holder's provider-console figure.
//
// HONESTY: `actualUsd` is USER-SUPPLIED text, stored verbatim (never computed,
// never rounded here). `estimatedUsd` is OUR figure captured at save time —
// an UPPER BOUND (cached-input discount invisible) reproducible via
// `pricingVersion`. The two are different epistemic categories and the UI
// must keep them labeled apart. Delta is DISPLAY math only; it is not a
// defect claim — our ESTIMATE covers only persisted app rows since the
// ledger's `since`, while the provider figure covers whatever period the
// account holder pasted (which may include calls this build never saw).
//
// Same retention family as UsageCall: plain strings, NO foreign key, NO
// cascade — reconciliation history is permanent account history. Additive
// (P5-c); nothing existing is touched.
// ---------------------------------------------------------------------------

model UsageInvoice {
  id             String   @id @default(cuid())
  // The pasted figure, EXACTLY as supplied (e.g. "12.34"). Parsed at display.
  actualUsd      String
  currency       String   @default("USD")
  // User-typed period the figure covers (e.g. "2026-11" or "Nov 5-6").
  periodLabel    String
  note           String?
  // Our ESTIMATE at save time — Σ over priced model groups, upper bound.
  estimatedUsd   String
  // UsageCall rows the estimate summed (0 pre-Phase-5 rows exist by design).
  trackedRows    Int
  // The ledger `since` at save — bounds what our ESTIMATE covered.
  sinceAtSave    String?
  pricingVersion String
  createdAt      DateTime @default(now())
  // Owner of this reconciliation figure (nullable: existing rows backfilled).
  userId         String?

  @@index([createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Credit ledger (Step 54) — the credit system's own two tables.
//
// CreditAccount is the CURRENT state (exactly one row per user);
// CreditLedger is the append-only history (every grant, spend, refund and
// adjustment, positive or negative).
//
// Both carry a `userId` scalar, so the ownership extension (src/lib/db.ts)
// covers them automatically — rule 1 (`userId -> { userId: uid }`): reads are
// filtered to the caller's own rows and creates are stamped with the
// caller's uid. Nothing in the credit module bypasses that.
//
// src/lib/credits/ledger.ts is the ONLY writer of CreditAccount.
// ---------------------------------------------------------------------------

model CreditAccount {
  userId         String   @id
  balance        Int      @default(0)
  // "YYYY-MM-DD" (UTC) — the last day the free allowance was granted.
  allowanceDate  String
  // What the last daily grant was worth (the configured allowance).
  allowanceGiven Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model CreditLedger {
  id        String   @id @default(cuid())
  userId    String
  // Negative = spend, positive = grant.
  delta     Int
  // daily_grant | spend | admin_grant | admin_usage | adjustment
  kind      String
  refId     String?
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// AI Team — restored per P5-g plan (agent-ctx/p5g-team1-repair-plan.md §3/§9).
// Deleted in f32b9df (Novara pivot); originals: b8aa210 (five models) +
// 7725023 (TeamTurnLog), verbatim from f32b9df^. The ONLY deltas from the
// originals are the two ruled convention adaptations:
//   1. plain-string novelId scope columns (NO FK, NO cascade — same style as
//      UsageCall.novelId) on TeamConversation + TeamTask;
//   2. these header comments.
// Internal relations keep the original onDelete: Cascade (same style as
// AgentEvent → AgentRun). Additive only — zero existing tables touched.
// ---------------------------------------------------------------------------

model TeamAgent {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  role         String
  description  String
  // JSON: string[]
  capabilities String
  isLeader     Boolean  @default(false)
  emoji        String   @default("🤖")
  color        String   @default("#059669")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  conversations TeamConversation[]
  assignedTasks TeamTask[] @relation("assignee")
  createdTasks  TeamTask[] @relation("creator")
}

model TeamConversation {
  id         String   @id @default(cuid())
  agentId    String
  sessionKey String   @default("default")
  // P5-g adaptation: workspace-pinned novel scope (plain string, no FK) —
  // conversations opened inside a novel workspace attribute there.
  novelId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  agent    TeamAgent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages TeamMessage[]

  @@unique([agentId, sessionKey])
}

model TeamMessage {
  id             String   @id @default(cuid())
  conversationId String
  // user | assistant | system
  role           String
  content        String
  // JSON: string[] — ids of tasks created via this (assistant) message
  taskIds        String?
  createdAt      DateTime @default(now())

  conversation TeamConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model TeamTask {
  id            String   @id @default(cuid())
  title         String
  description   String
  // pending | in_progress | completed | failed
  status        String   @default("pending")
  progress      Int      @default(0)
  result        String?
  error         String?
  // Browser session that owns this task — routes execution chat/report
  // appends to the right conversations.
  sessionKey    String   @default("default")
  // P5-g adaptation: delegation provenance (plain string, no FK) — tasks
  // created from a novel-scoped conversation inherit its novelId.
  novelId       String?
  assigneeId    String
  creatorId     String
  creatorIsUser Boolean  @default(false)
  // How many automatic leader follow-up rounds produced this task.
  // User-initiated tasks are 0; each auto-continued delegation +1.
  // The leader stops auto-continuing beyond MAX_AUTO_DEPTH.
  autoDepth     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignee TeamAgent     @relation("assignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  creator  TeamAgent     @relation("creator", fields: [creatorId], references: [id], onDelete: Cascade)
  logs     TeamTaskLog[]

  @@index([status])
}

model TeamTaskLog {
  id        String   @id @default(cuid())
  taskId    String
  message   String
  progress  Int      @default(0)
  createdAt DateTime @default(now())

  task TeamTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

// Turn telemetry — the observability layer of the self-healing loop.
// One row per glmAgentTurn (chat turns, task executions, follow-ups),
// classifying how the turn ended so problems (budget exhaustion, tool
// param errors, model failures) can be counted, alerted on, and learned
// from instead of only being visible as canned fallback texts.
model TeamTurnLog {
  id         String   @id @default(cuid())
  // Agent key when known ("leader", "writer"…); otherwise the glm label
  // ("task", "leader-followup", "task-closeout"…).
  agentKey   String
  // glm label passed to glmAgentTurn.
  label      String
  // answered | tool_exhausted | model_error
  outcome    String
  rounds     Int      @default(1)
  // JSON: [{round, action, ok, error}] — per-action outcomes.
  toolCalls  String?
  // JSON: string[] — corrections fired after this turn
  // (delegation-repair / claim-verify / continuation / ground-truth-note).
  correctionsFired String?
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())
  // Owner of this telemetry row (nullable: existing rows backfilled).
  userId     String?

  @@index([createdAt])
  @@index([agentKey, outcome])
  @@index([userId])
}
