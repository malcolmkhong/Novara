// ---------------------------------------------------------------------------
// Novara AI — AI-powered Novel Creation System
// SQLite + Prisma. Structured facts are the single source of truth.
// JSON columns are avoided (SQLite + Prisma); all relations are normalized.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Reserved for the future authentication system (NextAuth-ready).
// The current preview build uses a guest session and does not create users.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Novel — the aggregate root. Everything below cascades from it.
// ---------------------------------------------------------------------------

model Novel {
  id          String   @id @default(cuid())
  title       String
  genre       String   @default("")
  synopsis    String   @default("")
  targetWords Int      @default(100000)
  // drafting | completed | archived
  status      String   @default("drafting")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapters      Chapter[]
  characters    Character[]
  worldEntries  WorldEntry[]
  outlineBeats  OutlineBeat[]
  digests       ChapterDigest[]
  storyFacts    StoryFact[]
  characterStates CharacterState[]
  foreshadows   Foreshadow[]
  agentRuns     AgentRun[]

  @@index([updatedAt])
}

// ---------------------------------------------------------------------------
// Chapter — ordered by `index` (1-based). wordCount is authoritative,
// recomputed server-side on every save (never trusted from the client).
// ---------------------------------------------------------------------------

model Chapter {
  id        String   @id @default(cuid())
  novelId   String
  index     Int
  title     String
  content   String   @default("")
  wordCount Int      @default(0)
  // draft | revised | final
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  digest ChapterDigest?

  @@unique([novelId, index])
  @@index([novelId])
}

// ---------------------------------------------------------------------------
// Character — story bible cast entry.
// ---------------------------------------------------------------------------

model Character {
  id          String   @id @default(cuid())
  novelId     String
  name        String
  role        String   @default("")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
}

// ---------------------------------------------------------------------------
// WorldEntry — worldbuilding bible: places, factions, systems, items, lore.
// ---------------------------------------------------------------------------

model WorldEntry {
  id        String   @id @default(cuid())
  novelId   String
  title     String
  // location | faction | item | system | culture | other
  category  String   @default("other")
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
}

// ---------------------------------------------------------------------------
// OutlineBeat — plot outline beats in narrative order.
// ---------------------------------------------------------------------------

model OutlineBeat {
  id        String   @id @default(cuid())
  novelId   String
  index     Int
  title     String
  summary   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([novelId, index])
  @@index([novelId])
}

// ---------------------------------------------------------------------------
// Sediment layer (Phase 2) — written ONLY by the sediment pipeline
// (POST /api/chapters/[id]/sediment) after a blocking-free review.
// Single source of truth: each fact type has exactly one writable home.
// StoryFact mirrors the designed MemoryItem contract (agent-types.ts):
// category mirrors MemoryCategory; sourceChapter/firstSeen/lastSeen same
// semantics — Phase 4 builds FTS/recall on top of this table, not beside it.
// ---------------------------------------------------------------------------

model ChapterDigest {
  id        String   @id @default(cuid())
  chapterId String   @unique
  novelId   String
  summary   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  novel   Novel   @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId])
}

model StoryFact {
  id            String   @id @default(cuid())
  novelId       String
  // world_rule | character_state | relationship | story_fact | open_loop
  category      String
  content       String
  sourceChapter Int?
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @updatedAt
  // Chapter that last resurfaced this fact (sediment touch). Drives honest
  // recency in the Phase 4 retrieval scoring — a fact re-used in ch. 12 is
  // "hot" even if first planted in ch. 1.
  lastSeenChapter Int?

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, category])
}

model CharacterState {
  id           String   @id @default(cuid())
  novelId      String
  name         String
  chapterIndex Int
  state        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([novelId, name, chapterIndex])
  @@index([novelId, name])
}

model Foreshadow {
  id           String   @id @default(cuid())
  novelId      String
  content      String
  plantChapter Int
  payByChapter Int?
  // open -> advanced -> paid (settlement happens only in a sediment step)
  status       String   @default("open")
  lastChapter  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([novelId, status])
}

// ---------------------------------------------------------------------------
// Agent runtime (Phase 3) — the Agent Task Board's source of truth (§4.1).
// A run decomposes a goal into tasks, streams events, and pauses at gates.
// Honesty rule: task `done` flips are written by the runtime AFTER a verified
// DB write — never by model self-report. finalReport/payload hold JSON strings
// (SQLite + Prisma: no JSON columns), serialized into the frozen DTO shapes
// in lib/novara/agent-types.ts.
// ---------------------------------------------------------------------------

model AgentRun {
  id       String   @id @default(cuid())
  novelId  String
  novel    Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  goal     String
  // approval | full_access
  mode     String   @default("approval")
  // running | awaiting_approval | paused | completed | failed | cancelled
  status   String   @default("running")
  // RunFinalReport JSON (reported vs verified numbers) — null until finished
  finalReport String?
  error    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks  AgentTask[]
  events AgentEvent[]

  @@index([novelId, status])
  @@index([updatedAt])
}

model AgentTask {
  id     String   @id @default(cuid())
  runId  String
  run    AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  // Display key: "Task 1", "Task 3-a" (letter = parallel group member)
  key    String
  parallelGroup String?
  title  String
  detail String   @default("")
  // pending | in_progress | needs_approval | blocked | failed | done
  status String   @default("pending")
  // chapter | character | world_entry | outline_beat — binds to asset tree
  artifactType  String?
  artifactId    String?
  artifactLabel String?
  order  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([runId, order])
}

model AgentEvent {
  id     String   @id @default(cuid())
  runId  String
  run    AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  taskId String?
  // task_update | tool_call | write | message | error | approval
  kind   String
  summary String
  // JSON payload string (write events carry the pending draft for the gate)
  payload String?
  createdAt DateTime @default(now())

  @@index([runId, createdAt])
}
