# Novara AI — environment variables
# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# Neon PostgreSQL (pooled + direct). Copy to .env and set real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Browser-visible provider allowlist (provider names only, NOT a secret).
# Keeps the model picker's enabled/greyed state identical on server and client.
NEXT_PUBLIC_AI_PROVIDERS_ENABLED=gemini

# Admin allowlist (comma-separated Firebase UIDs). Server-side only.
ADMIN_UIDS=YOUR_ADMIN_UID_1,YOUR_ADMIN_UID_2

# Firebase Web SDK (public identifiers - safe in browser, inlined at build time).
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=novara-514009.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=novara-514009
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=novara-514009.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=9073132203
NEXT_PUBLIC_FIREBASE_APP_ID=1:9073132203:web:YOUR_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Verified working Gemini wire model (pin this; the registry default also uses it).
GEMINI_WIRE_MODEL_FAST=google/gemini-3.8-flash
GEMINI_WIRE_MODEL_PRO=google/gemini-3.8-flash

# ---------------------------------------------------------------------------
# AI 模型密钥说明（本文件不含任何真实密钥，只列键名）
#   · 当前唯一生效的模型网关是 z.ai / GLM，但 z-ai-web-dev-sdk 不读环境变量，
#     只读 .z-ai-config 文件（项目根 / 用户主目录 / /etc）。格式：
#       {"baseUrl":"https://api.z.ai/api/paas/v4","apiKey":"<key>"}
#     该文件已在 .gitignore 中。
#   · 换多 provider 后才会读取以下键（纯服务端，绝不进客户端）：
#     DEEPSEEK_API_KEY / MINIMAX_API_KEY / MINIMAX_GROUP_ID
#     OPENAI_API_KEY / ANTHROPIC_API_KEY
#   · Google Cloud 部署不需要任何 Google API key：VM 用机器身份 + OS Login，
#     Cloud Build 用自带服务账号，凭据不落代码。
#   · 完整「要准备什么」清单见本机 .env（gitignored，不随仓库分发）。
#
# 认证（Google Sign-In，见 DEPLOYMENT-GOOGLE.md v2 Step 4）本机开发需要：
#   AUTH_SECRET=<openssl rand -base64 48>        # 签名会话 Cookie，>=32 字节
#   GOOGLE_CLIENT_ID=<xxx.apps.googleusercontent.com>   # 公开值，不是密钥
#   ALLOWED_GOOGLE_EMAILS=<you@gmail.com,...>    # 白名单；为空时应用拒绝登录
# 生产这三项由 Secret Manager 注入 /etc/novara/novara.env，不写进本文件。
# 注意：Step 4 认证代码当前尚未落地（无 src/proxy.ts、无 /api/auth/*），
#       以下三项暂时不会被读取；DATABASE_URL 是当前唯一生效的环境变量。
# 只列键名、不含值。ALLOWED_GOOGLE_EMAILS 只能写一行，多个邮箱用逗号分隔：
AUTH_SECRET=
GOOGLE_CLIENT_ID=
ALLOWED_GOOGLE_EMAILS=
# ---------------------------------------------------------------------------
